{
    "name": "amyliu.dev",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "generate-types": "wrangler types",
        "dev": "npm run generate-types && astro dev",
        "redev": "npm run generate-types && astro dev --force",
        "build": "npm run generate-types && astro build",
        "deploy": "npm run generate-types && astro build && wrangler deploy",
        "preview": "npm run generate-types && astro build && wrangler dev",
        "astro": "astro",
        "lint": "npx prettier . --write --config=.prettierrc.mjs --no-editorconfig --cache --ignore-unknown",
        "prepare": "husky",
        "ci": "npm install && node ci.mjs"
    },
    "dependencies": {
        "@astro-community/astro-embed-youtube": "^0.5.10",
        "@astrojs/cloudflare": "^13.0.2",
        "@astrojs/react": "^5.0.0",
        "@astrojs/sitemap": "^3.7.1",
        "@daiji256/rehype-mathml": "^1.2.2",
        "@expressive-code/plugin-collapsible-sections": "^0.41.7",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@panzoom/panzoom": "^4.6.1",
        "@tailwindcss/vite": "^4.2.1",
        "@types/node": "^25.4.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "astro": "^6.0.2",
        "astro-d2": "^0.9.0",
        "astro-expressive-code": "^0.41.7",
        "choices.js": "^11.2.1",
        "date-fns": "^4.1.0",
        "hast-util-parse-selector": "^4.0.0",
        "mdast-util-mdx-jsx": "^3.2.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-tagcloud": "^2.3.3",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-callouts": "^2.1.2",
        "rehype-raw": "^7.0.0",
        "rehype-slug": "^6.0.0",
        "remark-math": "^6.0.0",
        "remark-sectionize-headings": "^0.2.8",
        "tailwindcss": "^4.2.1",
        "typed.js": "^3.0.0"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "husky": "^9.1.7",
        "prettier": "3.8.1",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "wrangler": "^4.72.0"
    }
}
