{
    "name": "amyliu.dev",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "ci": "npm install && node ci.mjs && wrangler types && python -m pip install -r requirements.txt && python scripts/generate_models3D_json.py && python scripts/generate_tags_json.py",
        "predev": "npm run ci",
        "preredev": "npm run ci",
        "prebuild": "npm run ci",
        "dev": "astro dev",
        "redev": "astro dev --force",
        "build": "astro build",
        "deploy": "astro build && wrangler deploy",
        "preview": "astro build && wrangler dev",
        "astro": "astro",
        "lint": "npx prettier . --write --config=.prettierrc.ts --ignore-path=.prettierignore --no-editorconfig --cache",
        "prepare": "husky"
    },
    "dependencies": {
        "@astro-community/astro-embed-youtube": "^0.5.10",
        "@astrojs/cloudflare": "^13.1.4",
        "@astrojs/react": "^5.0.2",
        "@astrojs/sitemap": "^3.7.2",
        "@daiji256/rehype-mathml": "^1.2.2",
        "@expressive-code/plugin-collapsible-sections": "^0.41.7",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@panzoom/panzoom": "^4.6.1",
        "@tailwindcss/vite": "^4.2.2",
        "@types/node": "^25.5.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "astro": "^6.1.3",
        "astro-d2": "^0.10.0",
        "astro-expressive-code": "^0.41.7",
        "choices.js": "^11.2.1",
        "date-fns": "^4.1.0",
        "expressive-code-language-badge": "^1.1.0",
        "hast-util-parse-selector": "^4.0.0",
        "mdast-util-mdx-jsx": "^3.2.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-tagcloud": "^2.3.3",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-callouts": "^2.1.2",
        "rehype-raw": "^7.0.0",
        "rehype-slug": "^6.0.0",
        "remark-math": "^6.0.0",
        "remark-sectionize-headings": "^0.2.8",
        "tailwindcss": "^4.2.2",
        "typed.js": "^3.0.0"
    },
    "devDependencies": {
        "@iconify/json": "^2.2.456",
        "@tailwindcss/typography": "^0.5.19",
        "husky": "^9.1.7",
        "prettier": "3.8.1",
        "prettier-plugin-astro": "0.14.1",
