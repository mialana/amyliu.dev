---
import "@/styles/projects.css";

import { format } from "date-fns";

import { type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import createSlug from "@/lib/createSlug";

interface Props {
    project: CollectionEntry<"projects">;
    image: any;
    "data-type"?: string;
    "data-category"?: string;
}

const {
    project,
    image,
    "data-type": dataType,
    "data-category": dataCategory,
} = Astro.props;

const finalizedSlug = createSlug(project.data.title, project.data?.slug);
---

{/* Wrap card in a passthrough link */}
<a href={`/projects/${finalizedSlug}/`} class="contents">
    <article
        id={`project-${finalizedSlug}`}
        {/* keep like so to allow table of contents scroll-to */}
        data-type={dataType}
        data-category={dataCategory}
        class="project-card-container"
    >
        <div>
            <Image
                class="project-card-image"
                src={image()}
                alt=`Project ${project.data.title} Thumbnail`
                width={800}
            />
        </div>
        <div class="project-card-text">
            <h1>
                {project.data.title}
            </h1>
            <h3>
                {format(project.data.startDate, "MMMM yyyy")} - {
                    format(project.data.endDate, "MMMM yyyy")
                }
            </h3>
            <h3">
                {project.data.category.toUpperCase()} · {
                    project.data.type.toUpperCase()
                }
            </h3">
            <p>
                {project.data.description}
            </p>
        </div>
        {
            project.data.pinned === true && (
                <div class="project-card-pinned-banner">pinned</div>
            )
        }
    </article>
</a>
