---
import ProjectsSort from "@/components/ProjectsSort.astro";

const PROJECTS_SELECT_CONTAINER_CLASSNAME = "projects-select-container";
const PROJECTS_SELECT_ELEMENT_CLASSNAME = "choices-projects-select";

const CHOICES_EXTRA_ELEMENT_CLASSNAME = "choices-extra-content-container";

interface Props {
    scrollableAncestor: string;
}

const { scrollableAncestor } = Astro.props;
---

<div
    id={PROJECTS_SELECT_CONTAINER_CLASSNAME}
    class=`u-mobile-dotted-border border-b-0 p-2`
    data-scrollable-ancestor={scrollableAncestor}
>
    <div class=`desktop:block prose text-2xs mb-1 hidden`>
        <h1>Projects Selection</h1>
    </div>
    <select id={PROJECTS_SELECT_ELEMENT_CLASSNAME} multiple data-placeholder="Filters & Options">
        <optgroup label="Category Filters">
            <option value="category:personal" data-select-text="Passion projects, original work">Personal</option>
            <option value="category:research" data-select-text="Funded research projects">Research</option>
            <option value="category:internship" data-select-text="Projects completed during internships"
                >Internship</option
            >
            <option value="category:school" data-select-text="University coursework">School</option>
        </optgroup>

        <optgroup label="Type Filters">
            <option value="type:solo" data-select-text="Fully individual projects">Solo</option>
            <option value="type:team" data-select-text="Projects created collaboratively">Team</option>
        </optgroup>
    </select>
</div>

<div id={CHOICES_EXTRA_ELEMENT_CLASSNAME} class="hidden">
    <div class="choices__heading">Additional Options</div>
    <ProjectsSort />
</div>

<script>
    import { initializeChoices } from "../lib/projects/handleProjectSelection";

    const PROJECTS_SELECT_CONTAINER_CLASSNAME = "projects-select-container";

    window.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById(PROJECTS_SELECT_CONTAINER_CLASSNAME);
        if (!container) return;

        const scrollableAncestor = container.dataset.scrollableAncestor ?? ":root";

        initializeChoices(scrollableAncestor);
    });
</script>
