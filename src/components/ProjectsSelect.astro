---
import ProjectsSort from "@/components/ProjectsSort.astro";

// keep in sync with `handleProjectSelection`
const PROJECTS_SELECT_CONTAINER_ID = "projects-select--container";
const PROJECTS_SELECT_ORIGIN_ID = "projects-select--origin";
const PROJECTS_SELECT_EXTRA_CONTAINER_ID = "projects-select__extra--container";

const CHOICES_HEADING_CLASSNAME = "choices__heading";

interface Props {
    scrollableAncestor: string;
}
---

<div
    id={PROJECTS_SELECT_CONTAINER_ID}
    class=`[--a2-projects-select-padding:calc(var(--spacing)*2)] u-mobile-dotted-border border-b-0 p-(--a2-projects-select-padding)`>
    <div class=`desktop:block prose-custom text-2xs mb-1 hidden`>
        <h1 class="m-0">Projects Selection</h1>
    </div>
    <select id={PROJECTS_SELECT_ORIGIN_ID} multiple data-placeholder="Filters & Options">
        <optgroup label="Category Filters">
            <option value="category:personal" data-select-text="Passion projects, original work">Personal</option>
            <option value="category:research" data-select-text="Funded research projects">Research</option>
            <option value="category:internship" data-select-text="Projects completed during internships"
                >Internship</option
            >
            <option value="category:school" data-select-text="University coursework">School</option>
        </optgroup>

        <optgroup label="Type Filters">
            <option value="type:solo" data-select-text="Fully individual projects">Solo</option>
            <option value="type:team" data-select-text="Projects created collaboratively">Team</option>
        </optgroup>
    </select>
</div>

<div id={PROJECTS_SELECT_EXTRA_CONTAINER_ID} class="hidden">
    <div class={CHOICES_HEADING_CLASSNAME}>Additional Options</div>
    <ProjectsSort />
</div>

<script>
    import { initializeChoices } from "../lib/projects/handleProjectSelection";

    window.addEventListener("DOMContentLoaded", initializeChoices);
</script>
