        <a href="/">AMY LIU</a>
    </h1>
    <div class="relative w-full p-1">
        <ul class="flex justify-center space-x-8 *:hover:underline">
            <li class:list={[Astro.url.pathname === "/" && "font-normal"]}>
                <a href="/">Home</a>
            </li>
            <li>
                <a
                    href="/projects/"
                    class:list={[
                        Astro.url.pathname === "/projects/" && "font-normal",
                    ]}>Projects</a
                >
            </li>
            <!-- <li><a>Blog</a></li> -->
            <!-- <li><a>Cache</a></li> -->
            <!-- <li><a>Art</a></li>
        <li><a>Notes</a></li> -->
        </ul>
        <div></div>
    </div>
</div>
<div class="relative mt-1 flex w-full justify-end">
    <ul
        class="*:bg-red-accent/90 flex font-medium text-white *:mr-4 *:rounded-b-md *:px-3 *:py-1 *:hover:scale-105"
    >
        <li>
            <a target="_blank" rel="noopener noreferrer" href="/resume.pdf"
