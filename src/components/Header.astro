---
const headerList = ["Home", "Projects", "Tags"];

const astroPathname = Astro.url.pathname;
---

<a href="/" class="prose font-signature text-center"><h1>AMY LIU</h1></a>

<ul class="gap-lg mx-auto flex justify-center">
    {/* Map headers and apply styling based on current path in site */}
    {
        headerList.map((h) => {
            let pathname = h === "Home" ? "/" : `/${h.toLowerCase()}/`;
            return (
                <li>
                    <a href={pathname}>
                        <h3
                            title={`Go to ${h}`}
                            class={`${astroPathname === pathname && "text-violet-accent font-bold"} hover:underline`}
                        >
                            {h}
                        </h3>
                    </a>
                </li>
            );
        })
    }
</ul>
<ul class="flex justify-end-safe text-sm backdrop-brightness-75">
    <li>
        <a target="_blank" rel="noopener noreferrer" href="/resume.pdf"
            ><h4 title="Open Resume" class="bg-primary-shade border-l-2 border-dotted px-2 hover:contrast-150">
                Resume
            </h4></a
        >
    </li>
</ul>
