---
import FaviconImage from "@/assets/webp/favicon-96x96.webp";

import FaviconInline from "@/assets/svg/favicon-64x64.svg";
const pageList = ["Home", "Projects", "Tags"];

const astroPathname = Astro.url.pathname;
---

{/* explicitly set header height due to favicon scaling on mobile */}
<div class="relative h-(--a2-header-height) [--a2-header-height:78px]">
    <div class="absolute top-0 right-0 flex aspect-square h-full items-center-safe justify-center-safe overflow-hidden">
        <i
            id="hero-favicon--container"
            class="desktop:[--a2-hero-favicon-size:64px] dark-theme:saturate-125 dark-theme:brightness-110 h-(--a2-hero-favicon-size) w-(--a2-hero-favicon-size) bg-transparent bg-none contrast-110 saturate-110 [--a2-hero-favicon-size:48px]">
            <FaviconInline />
        </i>
    </div>
    <div class="flex h-full flex-col justify-center-safe">
        {/* Create a wrapper div as prose-custom is applied to descendants */}
        <div id="header-signature--container" class="prose-custom font-signature relative max-w-none text-center">
            <h1 id="header-signature--heading" class="text-important-text m-0 mx-auto w-fit">
                {/* put padding on the link for accessibility, block to force height to adjust */}
                <a id="header-signature--anchor" href="/" class="block pt-2">AMY LIU</a>
            </h1>
        </div>

        <ul class="gap-md desktop:gap-lg mx-auto flex justify-center">
            {/* Map headers and apply styling based on current path in site */}
            {
                pageList.map((page) => {
                    let pagePath = page === "Home" ? "/" : `/${page.toLowerCase()}/`;
                    return (
                        <li id={`header-${page}-page--container`}>
                            <h1 id={`header-${page}-page--heading`}>
                                <a
                                    id={`header-${page}-page--anchor`}
                                    href={pagePath}
                                    title={`Go to ${page}`}
                                    class={`${astroPathname === pagePath ? "text-violet-accent font-bold" : ""} block px-1 pt-0.5 text-lg hover:underline`}>
                                    {page}
                                </a>
                            </h1>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</div>
