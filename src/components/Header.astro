---
import "@/styles/global.css";

const headerList = ["Home", "Projects", "Tags"];
---

<div class="bg-secondary">
    <h1 class="font-signature">
        <a href="/">AMY LIU</a>
    </h1>
    <ul
        class=""
    >
        {
            headerList.map((h) => {
                let pathname = h === "Home" ? "/" : `/${h.toLowerCase()}/`;
                return (
                    <li
                        class:list={[
                            Astro.url.pathname === pathname && "font-semibold",
                        ]}
                    >
                        <a href={pathname}>{h}</a>
                    </li>
                );
            })
        }
    </ul>
    <ul
        class=""
    >
        <li>
            <a target="_blank" rel="noopener noreferrer" href="/resume.pdf"
                >Resume</a
            >
        </li>
    </ul>
</div>
