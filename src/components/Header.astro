---
import "@/styles/global.css";
---

<div class="bg-secondary! z-20 pt-2 shadow-md md:shadow-lg">
    <h1 class="font-signature text-center text-4xl font-extrabold">
        <a href="/">AMY LIU</a>
    </h1>
    <ul
        class="mx-auto flex w-fit justify-center gap-[calc(var(--default-gap)*2)] pt-1 pb-2 *:hover:underline"
    >
        <li class:list={[Astro.url.pathname === "/" && "font-semibold"]}>
            <a href="/">Home</a>
        </li>
        <li>
            <a
                href="/projects/"
                class:list={[
                    Astro.url.pathname === "/projects/" && "font-semibold",
                ]}>Projects</a
            >
        </li>
    </ul>
    <ul
        class="*:bg-red-accent absolute right-4 bottom-2 flex gap-(--default-gap) font-medium *:rounded-md *:px-3 *:py-1 *:hover:scale-105"
    >
        <li>
            <a target="_blank" rel="noopener noreferrer" href="/resume.pdf"
                >Resume</a
            >
        </li>
    </ul>
</div>
