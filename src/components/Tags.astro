---
interface Props {
    content: string[];
    label: string;
}

const { content, label } = Astro.props;
---

<div class="text-important-text gap-sm flex flex-row items-baseline justify-start justify-items-start">
    <span class="text-inverted-neutral text-3xs snap-start text-nowrap">
        {label}
    </span>
    <ul class="gap-x-sm flex snap-x snap-mandatory overflow-x-scroll text-xs font-semibold">
        {
            content.map((tag) =>
                label === "tags" || label === "tech stack" ? (
                    <a
                        href={`/tags/${tag}/`}
                        class={`hover:text-red-accent cursor-grabbing snap-start text-nowrap no-underline`}
                    >
                        {label === "tags" && <span>#</span>}
                        {tag.replaceAll("_", " ")}
                    </a>
                ) : (
                    <span>{tag}</span>
                ),
            )
        }
    </ul>
</div>
