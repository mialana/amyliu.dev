---
interface Props {
    content: string[];
    label: string;
}

const { content, label } = Astro.props;
---

<div
    class="**:text-important-text my-1 flex max-w-full snap-x! snap-mandatory! items-baseline-last gap-3 overflow-x-scroll! scroll-auto pb-1 text-xs capitalize **:font-light xl:text-sm"
>
    <div class="text-inverted-neutral! snap-start! place-self-center-safe text-[0.4rem]/none font-bold uppercase">
        {label}
    </div>
    {
        label != "type" && label != "category" ? (
            content.map((tag) => (
                <a
                    href={`/tags/${tag}/`}
                    class={`not-prose hover:text-red-accent flex size-fit snap-start! items-center-safe gap-1 scroll-auto rounded-sm text-nowrap no-underline ${label == "tags" && "before:text-[0.6rem] before:content-['#']"}`}
                >
                    {tag.replaceAll("_", " ")}
                </a>
            ))
        ) : (
            <div>{content[0]}</div>
        )
    }
</div>
