---
import "@/styles/global.css";

interface Props {
    content: string[];
    label: string;
}

const { content, label } = Astro.props;
---

<div
    class="my-1 flex w-full !snap-x !snap-mandatory items-baseline gap-3 overflow-x-scroll pb-2 text-xs capitalize xl:text-sm"
>
    <div class="!snap-start text-[0.4rem]/none text-neutral-600 uppercase">
        {label}
    </div>
    {
        content.map((tag) => (
            <a
                href={`/tags/${tag}/`}
                class="hover:text-wanderer-300 size-fit !snap-start rounded-sm text-nowrap no-underline"
            >
                {label == "tags" && <span>#</span>}
                {tag.replaceAll("_", " ")}
            </a>
        ))
    }
</div>
