---
import { projectSortOrderArray, type ProjectSortOrder } from "@/lib/query";
import { camelCaseToHumanReadable } from "@/lib/utils";

const SORT_CONTAINER_CLASSNAME = "projects-sort-container";
const SORT_ORDER_ELEMENT_CLASSNAME = "projects-sort-order-element";

// use URL to set `sortOrder`
const maybeSortOrder: any | null = Astro.url.searchParams.get("sortOrder");

let currSortOrder: ProjectSortOrder =
    maybeSortOrder && projectSortOrderArray.includes(maybeSortOrder) ? maybeSortOrder : projectSortOrderArray[0];
---

<div
    id={SORT_CONTAINER_CLASSNAME}
    class="relative p-(--choices-dropdown-item-padding) text-(length:--choices-font-size-md)">
    <span>Sort Order</span>
    <ul class="u-choices--item-after cursor-pointer overflow-clip rounded-(--choices-border-radius-item)">
        {
            projectSortOrderArray.map((order) => {
                return (
                    <li
                        class={`${SORT_ORDER_ELEMENT_CLASSNAME} aria-selected:bg-violet-accent/50 bg-violet-accent/15 inline-block px-(--gap-md) hover:brightness-125`}
                        onclick={`onOrderSelected('${order}')`}
                        data-key={order}
                        aria-selected={order === currSortOrder}>
                        {camelCaseToHumanReadable(order)}
                    </li>
                );
            })
        }
    </ul>
</div>

<script is:inline>
    const SORT_ORDER_ELEMENT_CLASSNAME = "projects-sort-order-element";

    function syncSortOrder(sortOrder) {
        // set `ariaSelected` attribute on all buttons
        const buttons = document.querySelectorAll(`.${SORT_ORDER_ELEMENT_CLASSNAME}`);
        buttons.forEach((b) => {
            b.ariaSelected = b.dataset.key === sortOrder ? "true" : "false";
        });
    }

    function onOrderSelected(sortOrder) {
        const app = document.getElementById("app");
        if (!app) return;

        syncSortOrder(sortOrder);
        app.dataset.projectSortOrder = sortOrder;

        // set as search param in URL
        const url = new URL(window.location);
        url.searchParams.set("sortOrder", sortOrder);
        window.location.href = url.toString();
    }

    function fromContext() {
        const app = document.getElementById("app");
        if (!app) return;

        const url = new URL(window.location);

        const sortOrder = url.searchParams.get("sortOrder") ?? app.dataset.projectSortOrder ?? "startDate";
        syncSortOrder(sortOrder);
    }

    window.addEventListener("DOMContentLoaded", fromContext);
</script>
