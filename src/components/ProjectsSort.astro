---
import { projectSortOrderMap, type ProjectSortOrder } from "@/lib/projects/query";

const SORT_CONTAINER_CLASSNAME = "projects-sort-container";
const SORT_ORDER_ELEMENT_CLASSNAME = "projects-sort-order-element";

// use URL to set `sortOrder`
const maybeSortOrder: any | null = Astro.url.searchParams.get("sortOrder");

let currSortOrder: ProjectSortOrder =
    maybeSortOrder && Object.keys(projectSortOrderMap).includes(maybeSortOrder)
        ? maybeSortOrder
        : Object.keys(projectSortOrderMap)[0];
---

<div id={SORT_CONTAINER_CLASSNAME} class="p-(--choices-dropdown-item-padding) text-(length:--choices-font-size-md)">
    <span>Sort Order</span>
    <ul class="float-end inline-block cursor-pointer overflow-clip rounded-(--choices-border-radius-item)">
        {
            Object.entries(projectSortOrderMap).map(([order, label]) => {
                return (
                    <li
                        class={`${SORT_ORDER_ELEMENT_CLASSNAME} aria-selected:bg-violet-accent/50 bg-violet-accent/15 inline-block px-(--a2-spacing-atoms) hover:brightness-125`}
                        onclick={`onOrderSelected('${order}')`}
                        data-key={order}
                        aria-selected={order === currSortOrder ? "true" : "false"}
                    >
                        {label}
                    </li>
                );
            })
        }
    </ul>
</div>

<script is:inline>
    const SORT_ORDER_ELEMENT_CLASSNAME = "projects-sort-order-element";

    function onOrderSelected(sortOrder) {
        // set `ariaSelected` attribute on all buttons
        const buttons = document.querySelectorAll(`.${SORT_ORDER_ELEMENT_CLASSNAME}`);
        buttons.forEach((b) => {
            b.ariaSelected = b.dataset.key === sortOrder ? "true" : "false";
        });

        document.documentElement.dataset.projectsSortOrder = sortOrder;
    }
</script>
