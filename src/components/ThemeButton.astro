---
import MoonIcon from "~icons/line-md/moon-rising-alt-twotone-loop";
import SunIcon from "~icons/line-md/sun-rising-twotone-loop";
---

<button id="theme-button" class="text-inverted-primary cursor-pointer p-2" aria-label="Toggle Theme Button">
    <span class="dark-theme:hidden u-icon" title="Toggle on Dark Mode"><MoonIcon /> </span>
    <span class="not-dark-theme:hidden u-icon" title="Toggle on Light Mode"><SunIcon /></span>
</button>

<script>
    import { initializeThemeButton } from "@/lib/handleThemeButton";

    window.addEventListener("DOMContentLoaded", () => {
        initializeThemeButton();
    });
</script>
