---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}
const { headings = [] } = Astro.props;

/* Headings are given as a flat list */
/* create a `Node` type that is a MarkdownHeading combined with other headings that are within that heading */
type Node = MarkdownHeading & { children: Node[] };
const root: Node = { depth: 0, slug: "", text: "", children: [] };
const stack: Node[] = [root];

for (const h of headings) {
    let p = stack.at(-1);
    while (stack.length && h.depth <= p!.depth) {
        /* pop until we reach the headings "parent". 
        popping also means this heading has no more children */
        stack.pop();
        p = stack.at(-1);
    }
    const node: Node = { ...h, children: [] };
    p!.children.push(node);
    stack.push(node); /* push this node onto stack as a non-processed node */
}
---

<section>
    <h1>On This Page</h1>
    <ul class="*:font-light">
        {
            (function renderTree(nodes: Node[]): any {
                return nodes.map((node) => (
                    <li data-slug={node.slug}>
                        <div class={`relative`}>
                            <a href={`#${node.slug}`} class="toc-heading-anchor relative hover:underline">
                                {node.text}
                            </a>
                        </div>
                        {node.children.length > 0 && <ul class="pl-3">{renderTree(node.children)}</ul>}
                    </li>
                ));
            })(root.children)
        }
    </ul>
    <script>
        import { handleScrollToAnchorTarget } from "../lib/projects/handleScrollBehavior.ts";

        window.addEventListener(
            "scroll",
            (e) => {
                console.log("viewport scrolled");
                console.log(document.documentElement.scrollTop);
                console.log(document.body.scrollTop);

                if (document.documentElement.scrollTop > 0) {
                    window.scrollTo(0, 0);
                }
            },
            false,
        );

        window.addEventListener("DOMContentLoaded", () => {
            const container = document.getElementById("main-grid-cell");
            if (!container) return;

            const anchors = document.querySelectorAll<HTMLAnchorElement>(".toc-heading-anchor");

            /* add event listener for all anchors */
            anchors.forEach((anchor) => {
                anchor.addEventListener("click", (e) => {
                    e.preventDefault();

                    // manually scroll into view
                    handleScrollToAnchorTarget(anchor, container);
                });
            });

            function lazyUpdateActiveHeading() {
                if (!container) return;
                history.replaceState(null, "", location.pathname + location.search);

                const hash = window.location.hash;

                anchors.forEach((anchor) => {
                    if (anchor.getAttribute("href") === hash) {
                        anchor.classList.add("font-semibold", "text-blue-accent");

                        handleScrollToAnchorTarget(anchor, container);
                    } else {
                        anchor.classList.remove("font-semibold", "text-blue-accent");
                    }
                });
            }

            // Run on load and whenever the hash changes
            lazyUpdateActiveHeading();
            window.addEventListener("hashchange", lazyUpdateActiveHeading);
        });
    </script>
</section>
