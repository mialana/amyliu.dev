---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}
const { headings = [] } = Astro.props;

const TOC_ANCHOR_CLASSNAME = "toc-heading-anchor";
const ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME = "anchor-with-scroll-behavior";

/* Headings are given as a flat list */
/* create a `Node` type that is a MarkdownHeading combined with other headings that are within that heading */
type Node = MarkdownHeading & { children: Node[] };
const root: Node = { depth: 0, slug: "", text: "", children: [] };
const stack: Node[] = [root];

for (const h of headings) {
    let p = stack.at(-1);
    while (stack.length && h.depth <= p!.depth) {
        /* pop until we reach the headings "parent". 
        popping also means this heading has no more children */
        stack.pop();
        p = stack.at(-1);
    }
    const node: Node = { ...h, children: [] };
    p!.children.push(node);
    stack.push(node); /* push this node onto stack as a non-processed node */
}
---

<section class="bg-primary-shade desktop:bg-primary-neutral p-2">
    <div id="on-this-page">
        <h1
            class="desktop:border-0 desktop:hidden border-primary-shadow/50 bg-primary-neutral w-fit rounded-sm border px-2 shadow-sm"
        >
            On This Page <span class="fa-solid fa-caret-down"></span>
        </h1>
    </div>
    <ul class="desktop:block hidden *:font-light">
        {
            (function renderTree(nodes: Node[]): any {
                return nodes.map((node) => (
                    <li data-slug={node.slug}>
                        <a
                            href={`#${node.slug}`}
                            class={`${TOC_ANCHOR_CLASSNAME} ${ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME} relative hover:underline`}
                        >
                            {node.text}
                        </a>
                        {node.children.length > 0 && <ul class="pl-3">{renderTree(node.children)}</ul>}
                    </li>
                ));
            })(root.children)
        }
    </ul>
    <script>
        import { updateActiveHeading } from "../lib/projects/handleScrollBehavior.ts";

        window.addEventListener("DOMContentLoaded", () => {
            // Run on load and whenever the hash changes
            updateActiveHeading();
            window.addEventListener("hashchange", () => updateActiveHeading());
        });
    </script>
</section>
