---
import type { MarkdownHeading } from "astro";

import { createTocTree, type TocNode } from "@/lib/projects/handleTocBehavior";

const TOC_ANCHOR_CLASSNAME = "toc-heading-anchor";
const ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME = "anchor-with-scroll-behavior";

interface Props {
    headings: MarkdownHeading[];
}
const { headings = [] } = Astro.props;

const root: TocNode = createTocTree(headings);
---

<div class="bg-primary-shade desktop:bg-primary-neutral w-full">
    <div id="on-this-page" aria-expanded="false" aria-controls="toc-list">
        <div
            class="desktop:border-0 border-primary-shadow/50 bg-primary-neutral desktop:font-bold pointer-events-auto w-fit rounded-xs border px-2"
        >
            On This Page <span class="fa-solid fa-caret-down desktop:text-transparent"></span>
        </div>
    </div>
    <ul
        id="toc-list"
        class="desktop:max-h-fit desktop:static bg-primary-neutral fixed z-20 max-h-0 w-full overflow-x-hidden overflow-y-scroll text-sm transition-[max-height]"
    >
        {
            (function renderTree(nodes: TocNode[]): any {
                // creates a tree-like appearance with `padding-left` and `margin-bottom` magic
                return nodes.map((node: TocNode) => (
                    <li data-slug={node.slug} class="toc-item pb-1">
                        <a
                            href={`#${node.slug}`}
                            class={`${TOC_ANCHOR_CLASSNAME} ${ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME} relative hover:underline`}
                        >
                            {node.text}
                        </a>
                        {node.children.length > 0 && <ul class="pl-3">{renderTree(node.children)}</ul>}
                    </li>
                ));
            })(root.children)
        }
    </ul>
    <script>
        import { updateActiveHeading } from "../lib/projects/handleScrollBehavior.ts";
        import { handleOnThisPageBehavior } from "../lib/projects/handleTocBehavior.ts";

        window.addEventListener("DOMContentLoaded", () => {
            // Run on load and whenever the hash changes
            updateActiveHeading();
            window.addEventListener("hashchange", () => updateActiveHeading());

            handleOnThisPageBehavior();
        });
    </script>
</div>
