---
import type { MarkdownHeading } from "astro";

import CaretDownIcon from "~icons/fa6-solid/caret-down";

import { createTocTree, type TocNode } from "@/lib/projects/handleTocBehavior";

const TOC_ANCHOR_CLASSNAME = "toc-heading-anchor";
const ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME = "anchor-with-scroll-behavior";

interface Props {
    headings: MarkdownHeading[];
}
const { headings = [] } = Astro.props;

const root: TocNode = createTocTree(headings);
---

{/* Styling for `aria-expanded` behavior defined in `global.css` under `u-toc` */}
<div id="toc-container" class="u-mobile-dotted-border w-full p-2" aria-expanded="false" aria-controls="toc-list">
    <div id="on-this-page">
        <div
            id="on-this-page-label"
            class="desktop:font-bold desktop:border-0 desktop:backdrop-brightness-100 border-inverted-neutral/25 pointer-events-auto w-fit rounded-xs border px-2 backdrop-brightness-110"
        >
            <span>On This Page</span>
            <CaretDownIcon class="u-icon desktop:hidden inline" />
        </div>
    </div>
    {/* Since it's fixed positioning on mobile, it is the scrolling container */}
    <ul
        id="toc-list"
        class="desktop:max-h-full desktop:static bg-primary-neutral border-inverted-neutral/25 desktop:overflow-y-hidden fixed z-20 max-h-0 w-full overflow-hidden overflow-y-scroll rounded-xs text-sm transition-[max-height]"
    >
        {
            (function renderTree(nodes: TocNode[]): any {
                // creates a tree-like appearance with `padding-left` and `margin-bottom` magic
                return nodes.map((node: TocNode) => (
                    <li data-slug={node.slug} class="toc-item mb-(--gap-sm) leading-tight">
                        <a
                            href={`#${node.slug}`}
                            class={`${TOC_ANCHOR_CLASSNAME} ${ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME} relative hover:underline`}
                        >
                            {node.text}
                        </a>
                        {node.children.length > 0 && <ul class="pl-3">{renderTree(node.children)}</ul>}
                    </li>
                ));
            })(root.children)
        }
    </ul>
    <script>
        import { updateActiveHeading } from "../lib/projects/handleScrollBehavior.ts";
        import { initializeOnThisPageBehavior } from "../lib/projects/handleTocBehavior.ts";

        window.addEventListener("DOMContentLoaded", () => {
            // Run on load and whenever the hash changes
            updateActiveHeading();
            window.addEventListener("hashchange", () => updateActiveHeading());

            initializeOnThisPageBehavior();
        });
    </script>
</div>
