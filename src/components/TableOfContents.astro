---
import type { MarkdownHeading } from "astro";

import createTocTree, { type TocNode } from "@/lib/projects/createTocTree";

const TOC_ANCHOR_CLASSNAME = "toc-heading-anchor";
const ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME = "anchor-with-scroll-behavior";

interface Props {
    headings: MarkdownHeading[];
}
const { headings = [] } = Astro.props;

const root: TocNode = createTocTree(headings);
---

<section class="bg-primary-shade desktop:bg-primary-neutral p-2">
    <div id="on-this-page">
        <h1
            class="desktop:border-0 desktop:hidden border-primary-shadow/50 bg-primary-neutral w-fit rounded-sm border px-2 shadow-sm"
        >
            On This Page <span class="fa-solid fa-caret-down"></span>
        </h1>
    </div>
    <ul class="desktop:block hidden text-sm">
        {
            (function renderTree(nodes: TocNode[]): any {
                // creates a tree-like appearance with `padding-left` and `margin-bottom` magic
                return nodes.map((node: TocNode) => (
                    <li data-slug={node.slug} class="toc-item mb-1">
                        <a
                            href={`#${node.slug}`}
                            class={`${TOC_ANCHOR_CLASSNAME} ${ANCHOR_WITH_SCROLL_BEHAVIOR_CLASSNAME} relative hover:underline`}
                        >
                            {node.text}
                        </a>
                        {node.children.length > 0 && <ul class="pl-3">{renderTree(node.children)}</ul>}
                    </li>
                ));
            })(root.children)
        }
    </ul>
    <script>
        import { updateActiveHeading } from "../lib/projects/handleScrollBehavior.ts";

        window.addEventListener("DOMContentLoaded", () => {
            // Run on load and whenever the hash changes
            updateActiveHeading();
            window.addEventListener("hashchange", () => updateActiveHeading());
        });
    </script>
</section>
