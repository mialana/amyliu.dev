---
import SideBarButton from "@/components/SideBarButton.astro";

interface Props {
    isNavActive: boolean;
    isAsideActive: boolean;
}

const { isNavActive, isAsideActive }: Props = Astro.props;
---

<div class="flex items-center-safe [--a2-toolbar-height:1.75rem]">
    {isNavActive && <SideBarButton sideBarType="nav" />}

    <a
        target="_blank"
        rel="noopener noreferrer"
        href="/materials/resume.pdf"
        class="bg-primary-shade desktop:border-x-2 ml-auto border-l-2 border-dotted contrast-125"
        ><h4 title="Open Resume" class="px-2 leading-(--a2-toolbar-height) hover:contrast-150">Resume</h4></a
    >

    {isAsideActive && <SideBarButton sideBarType="aside" />}
</div>
