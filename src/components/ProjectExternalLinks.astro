---
import createExternalLinks from "@/lib/projects/createExternalLinks";
import { type ExternalLinkItem, getLinkFavicon } from "@/lib/projects/createExternalLinks";
import { Image } from "astro:assets";

interface Props {
    code?: string;
    externalLinks?: string[];
}

const { code, externalLinks = [] } = Astro.props;

const links: ExternalLinkItem[] = createExternalLinks(code, externalLinks);
---

<div
    id="project-external-links-container"
    class="desktop:flex-col u-mobile-dotted-border flex items-center justify-evenly gap-4 px-2 py-4">
    {
        links.map(({ url, label }) => (
            <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="mx-auto flex w-20 flex-col items-center gap-2">
                <div class="bg-inverted-secondary/50 desktop:rounded-2xl flex h-16 w-16 items-center justify-center rounded-md border p-1 shadow hover:scale-105">
                    <Image
                        src={getLinkFavicon(url)}
                        alt={`Favicon ${label}`}
                        width={42}
                        height={42}
                        class="external-link-image desktop:rounded-2xl size-3/4 rounded-xl bg-none p-2"
                    />
                </div>
                <span class="text-2xs desktop:text-xs mt-1 text-center leading-tight">{label}</span>
            </a>
        ))
    }
</div>

<script is:inline>
    /**
     * the favicon fetching often takes a while in production so this keeps the loading GIF
     * until they are fully loaded
     */
    document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("project-external-links-container");
        if (!container) return;

        container.querySelectorAll("img").forEach((img) => {
            const onLoad = () => {
                img.classList.add("bg-none", "bg-white");
            };

            if (img.complete && img.naturalWidth !== 0) {
                onLoad(); // already loaded
            } else {
                img.addEventListener("load", onLoad, { once: true });
            }
        });
    });
</script>
