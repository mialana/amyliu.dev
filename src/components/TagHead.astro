---
import type { CollectionEntry } from "astro:content";

import type { ContentView } from "@/lib/query";

interface Props {
    tag: CollectionEntry<"tags">;
    content: ContentView[];
}

const { tag, content } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;

const description = `Projects tagged '${tag.data.title}' (${content.length} projects).`;

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${tag.data.title} Projects`,
    description,
    url,
    mainEntity: content.map((ref) => ({
        "@type": "CreativeWork",
        name: ref.title,
        url: new URL(ref.href, Astro.site).href,
        ...(ref.description ? { description: ref.description } : {}),
        ...(ref.id ? { identifier: ref.id } : {}),
    })),
});
---

<meta name="description" content={description} />

<meta name="keywords" content={tag.data.title} />

<link rel="canonical" href={url} />

<script is:inline type="application/ld+json" set:html={jsonLd} />
