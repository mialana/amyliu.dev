---
import type { CollectionEntry } from "astro:content";

interface Props {
    tag: string;
    projects: CollectionEntry<"projects">[];
}

const { tag, projects } = Astro.props;

const tagTitle = tag.replaceAll("_", " ");
const url = new URL(Astro.url.pathname, Astro.site).href;

const description = `Projects tagged '${tagTitle}' (${projects.length} projects).`;

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${tagTitle} Projects`,
    description,
    url,
    mainEntity: projects.map((p) => ({
        "@type": "CreativeWork",
        name: p.data.title,
        url: new URL(`/projects/${p.data.slug}/`, Astro.site).href,
        ...(p.data.description ? { description: p.data.description } : {}),
        ...(p.data.slug ? { identifier: p.data.slug } : {}),
    })),
});
---

<meta name="description" content={description} />

<meta name="keywords" content={tagTitle} />

<link rel="canonical" href={url} />

<script is:inline type="application/ld+json" set:html={jsonLd} />
