---
import type { CollectionEntry } from "astro:content";

interface Props {
    tag: CollectionEntry<"tags">;
    projects: CollectionEntry<"projects">[];
}

const { tag, projects } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;

const description = `Projects tagged '${tag.data.title}' (${projects.length} projects).`;

const jsonLd = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${tag.data.title} Projects`,
    description,
    url,
    mainEntity: projects.map((ref) => ({
        "@type": "CreativeWork",
        name: ref.data.title,
        url: new URL(`/projects/${ref.id}/`, Astro.site).href,
        ...(ref.data.description ? { description: ref.data.description } : {}),
        ...(ref.id ? { identifier: ref.id } : {}),
    })),
});
---

<meta name="description" content={description} />

<meta name="keywords" content={tag.data.title} />

<link rel="canonical" href={url} />

<script is:inline type="application/ld+json" set:html={jsonLd} />
