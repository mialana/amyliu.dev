---
import ThemeButton from "./ThemeButton";

const footerMap = [
    { label: "GitHub", href: "https://github.com/mialana/", icon: "fa-brands fa-github" },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/miyalana/", icon: "fa-brands fa-linkedin" },
    { label: "Email", href: "mailto:liu.amy05@gmail.com", icon: "fa-solid fa-envelope" },
];
---

<ul class="gap-lg flex justify-center">
    {
        footerMap.map(({ label, href, icon }) => (
            <li>
                <a href={href} target="_blank" rel="noopener noreferrer" title={`Find me on ${label}`}>
                    <span class={`u-fa-icon ${icon}`} />
                </a>
            </li>
        ))
    }
</ul>

<div class="prose prose-xs horizontal:prose-sm max-w-none text-center">
    <code>
        © 2025 · developed by Amy Liu · powered by <a
            class="font-medium"
            target="_blank"
            rel="noopener noreferrer"
            href="https://astro.build/">Astro</a
        >
    </code>
    <div class="float-right inline-block px-2">
        <ThemeButton client:load />
    </div>
</div>
