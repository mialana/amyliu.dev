---
import ThemeButton from "@/components/ThemeButton.astro";

import GithubIcon from "~icons/fa6-brands/github-square";
import LinkedinIcon from "~icons/fa6-brands/linkedin";
import EmailIcon from "~icons/fa-solid/envelope-square";

const footerMap = [
    { label: "GitHub", href: "https://github.com/mialana/", Icon: GithubIcon },
    { label: "LinkedIn", href: "https://www.linkedin.com/in/miyalana/", Icon: LinkedinIcon },
    { label: "Email", href: "mailto:liu.amy05@gmail.com", Icon: EmailIcon },
];
---

<ul class="gap-lg flex justify-center">
    {
        footerMap.map(({ label, href, Icon }) => (
            <li>
                <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="pt-2 pb-0"
                    title={`Click for my ${label}!`}>
                    <Icon class="u-icon" />
                </a>
            </li>
        ))
    }
</ul>

<div class="grid grid-cols-[1fr_auto_1fr] items-center-safe pb-1">
    <div class="prose-custom prose-xs desktop:prose-sm col-start-2 text-center tracking-tighter">
        <code class="inline-block">
            © 2025 · developed by Amy Liu · powered by <a
                target="_blank"
                rel="noopener noreferrer"
                href="https://astro.build/"
                class="inline-block py-1">Astro</a
            >
        </code>
    </div>
    <div class="justify-self-end-safe">
        <ThemeButton />
    </div>
</div>
