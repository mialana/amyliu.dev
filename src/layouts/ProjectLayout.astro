---
import { type CollectionEntry } from "astro:content";
import { format } from "date-fns";

import Tags from "@/components/Tags.astro";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectBreakdown from "@/components/ProjectBreakdown";

import ComingSoon from "@/components/ComingSoon";

import createSlug from "@/lib/createSlug";

interface Props {
    project: CollectionEntry<"projects">;
    showBreakdown?: boolean;
    replaceImagePlaceholder?: boolean;
    showTags?: boolean;
}

const {
    project,
    showBreakdown = true,
    replaceImagePlaceholder = false,
    showTags = true,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/content/projects/*/assets/thumbnail.{png,webp}",
);

const finalizedSlug = createSlug(project.data.title, project.data?.slug);
const thumbnailPath = images[
    `/src/content/projects/${finalizedSlug}/assets/thumbnail.webp`
]
    ? `/src/content/projects/${finalizedSlug}/assets/thumbnail.webp`
    : `/src/content/projects/${finalizedSlug}/assets/thumbnail.png`;

console.log(project);
---

<div
    class="mx-auto max-w-5xl flex-col items-center-safe justify-center-safe px-2 py-4"
>
    <div id="project-headings" class="prose text-center">
        <h1 class="my-0! text-4xl lg:text-5xl xl:text-6xl">
            <a
                id="project-title-link"
                class="font-bold no-underline"
                href={`/projects/${createSlug(
                    project.data.title,
                    project.data.slug,
                )}/`}
            >
                {project.data.title}
            </a>
        </h1>
        <h3 class="mt-2! mb-4! text-sm font-extrabold xl:text-base">
            {format(project.data.startDate, "MMMM dd, yyyy")} -
            {format(project.data.endDate, "MMMM dd, yyyy")}
        </h3>
        <div
            class="prose-custom-lg project-description max-w-none text-sm xl:text-base"
        >
            {project.data.description}
        </div>
    </div>

    <div class="shadow-lg">
        {
            project.data.demoVideoLink ? (
                <YouTube
                    id={project.data.demoVideoLink}
                    params="autoplay=1&color=white&rel=0"
                    posterQuality="max"
                />
            ) : !replaceImagePlaceholder ? (
                <Image
                    src={images[thumbnailPath]()}
                    alt={`Fallback Thumbnail ${project.data.title}`}
                />
            ) : (
                <ComingSoon showHeader={false} />
            )
        }
    </div>

    <ComingSoon showHeader={false} />

    <!--
    {
        showTags && (
            <div class="prose prose-lg xl:prose-2xl tags-container mx-auto max-w-full">
                <Tags content={[project.data.category]} label="category" />
                <Tags content={[project.data.type]} label="type" />
                <Tags content={project.data.tags} label="tags" />
                <Tags content={project.data.techStack} label="tech stack" />
            </div>
        )
    }

    {
        showBreakdown && (
            <ProjectBreakdown client:load>
                <slot />
            </ProjectBreakdown>
        )
    } -->
</div>
