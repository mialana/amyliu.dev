---
import { type CollectionEntry } from "astro:content";
import { format } from "date-fns";

import Tags from "@/components/Tags.astro";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ProjectBreakdown from "@/components/ProjectBreakdown";

import ComingSoon from "@/components/ComingSoon";

import createSlug from "@/lib/createSlug";

interface Props {
    project: CollectionEntry<"projects">;
    showBreakdown?: boolean;
    replaceImagePlaceholder?: boolean;
    showTags?: boolean;
}

const { project, showBreakdown = true, replaceImagePlaceholder = false, showTags = true } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>("/src/content/projects/*/assets/thumbnail.{png,webp}");

const finalizedSlug = createSlug(project.data.title, project.data?.slug);
const thumbnailPath = images[`/src/content/projects/${finalizedSlug}/assets/thumbnail.webp`]
    ? `/src/content/projects/${finalizedSlug}/assets/thumbnail.webp`
    : `/src/content/projects/${finalizedSlug}/assets/thumbnail.png`;
---

<div class="my-4 flex grow flex-col items-center-safe justify-center-safe overflow-y-scroll px-4 lg:my-12 lg:px-16">
    <div id="project-headings" class="prose max-w-full text-center">
        <a id="project-title-link" href={`/projects/${createSlug(project.data.title, project.data.slug)}/`}>
            <h1>
                {project.data.title}
            </h1>
        </a>
        <time datetime={project.data.startDate.toISOString()}>
            {format(project.data.startDate, "MMMM dd, yyyy")}
        </time>
        {" – "}
        <time datetime={project.data.endDate.toISOString()}>
            {format(project.data.endDate, "MMMM dd, yyyy")}
        </time>
        <samp>
            {project.data.description}
        </samp>
    </div>
    <div
        class="project-visual-container *:project-visual bg-primary-neutral mt-4 mb-6 w-full max-w-7xl! p-2 shadow-lg lg:mt-6 lg:mb-8"
    >
        {
            project.data.demoVideoLink ? (
                <YouTube
                    id={project.data.demoVideoLink}
                    params="autoplay=1&color=white&rel=0"
                    posterQuality="max"
                    class="w-full min-w-full"
                />
            ) : !replaceImagePlaceholder ? (
                <Image class="w-full" src={images[thumbnailPath]()} alt={`Fallback Thumbnail ${project.data.title}`} />
            ) : (
                <div>
                    <ComingSoon showHeader={false} />
                </div>
            )
        }
    </div>
    {
        showTags && (
            <div class="prose prose-lg xl:prose-2xl tags-container mx-auto max-w-full">
                <Tags content={[project.data.category]} label="category" />
                <Tags content={[project.data.type]} label="type" />
                <Tags content={project.data.tags} label="tags" />
                <Tags content={project.data.techStack} label="tech stack" />
            </div>
        )
    }

    <div class="prose">
        <slot />
    </div>
</div>
