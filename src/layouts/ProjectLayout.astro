---
import { type CollectionEntry } from "astro:content";
import { format } from "date-fns";

import Tags from "@/components/Tags.astro";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { Image } from "astro:assets";

interface Props {
    project: CollectionEntry<"projects">;
    showBreakdown?: boolean;
    replaceImagePlaceholder?: boolean;
    showTags?: boolean;
}

const { project } = Astro.props;
---

<div
    class="prose prose-sm horizontal:prose-base flex flex-col justify-center-safe overflow-hidden"
    style="max-width: var(--container-3xl); width: 100%;"
>
    <section id="project-headings" class="prose-sm md:prose-base text-center">
        <h1>
            <a id="project-h1-anchor" href={`/projects/${project.data.slug}/`}>
                {project.data.title}
            </a>
        </h1>

        <figcaption class="inline-block">
            <time datetime={project.data.startDate.toISOString()}>
                {format(project.data.startDate, "MMMM dd, yyyy")}
            </time>
            {" – "}
            <time datetime={project.data.endDate.toISOString()}>
                {format(project.data.endDate, "MMMM dd, yyyy")}
            </time>

            <p class="mx-auto w-3/4">
                {project.data.description}
            </p>
        </figcaption>
    </section>
    <div class="not-prose my-4">
        {
            project.data.demoVideoLink ? (
                <YouTube
                    id={project.data.demoVideoLink}
                    params="autoplay=1&color=white&rel=0"
                    posterQuality="max"
                    class="block min-w-full"
                />
            ) : (
                <Image
                    src={project.data.thumbnail}
                    alt={`Project ${project.data.title} Fallback Thumbnail`}
                    class="mx-auto"
                    widths={[320, 400, 480, 640, 768]}
                    sizes={`(max-width: 320px) 320px, (max-width: 400px) 400px, (max-width: 480px) 480px, (max-width: 640px) 640px, 768px`}
                />
            )
        }
    </div>
    <div class="not-prose">
        <Tags content={[project.data.category]} label="category" />
        <Tags content={[project.data.type]} label="type" />
        <Tags content={project.data.tags} label="tags" />
        <Tags content={project.data.techStack} label="tech stack" />
    </div>

    <article id="project-content">
        <hr />
        <slot />
    </article>
</div>
<script>
    import postprocessProjectContent from "../lib/postprocessProjectContent";

    document.addEventListener("DOMContentLoaded", postprocessProjectContent);
</script>
