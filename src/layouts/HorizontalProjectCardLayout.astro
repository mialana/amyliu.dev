---
import { format } from "date-fns";
import { Image } from "astro:assets";

import RightArrowIcon from "~icons/tabler/arrow-big-right-filled";
import PlusIcon from "~icons/tabler/square-rounded-plus-filled";

import { type ProjectEntryStructured } from "@/lib/projects/query";

export interface CardSource {
    title: string;
    slug: string;
    kind: string;
}

interface Props {
    project: ProjectEntryStructured;
    source: CardSource;
}

const { project, source } = Astro.props as Props;
const {
    id,
    data: { title, thumbnail_540w, tagsLike },
} = project;
const { title: sourceTitle, slug: sourceSlug, kind: sourceKind } = source;

const buildElementID = (suffix: string = "") => `${sourceSlug}-${sourceKind}-${project.id}-project-card-${suffix}`;

const overview = "data-[display=overview]";
const more = "data-[display=more]";
const groupOverview = `group-${overview}/card`;
const groupMore = `group-${more}/card`;

import ProjectCardLayout from "@/layouts/ProjectCardLayout.astro";
---

<ProjectCardLayout project={project} idPrefix={`${source.kind}-`} />
