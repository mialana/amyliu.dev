import "@/styles/global.css";
import Page from "@/components/page";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ThemeClient from "@/lib/ThemeClient.astro";

interface Props {
    title: string;
    navVisible?: boolean;
    asideVisible?: boolean;
}

const { title, navVisible = false, asideVisible = false } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
        <link rel="shortcut icon" href="/favicon/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicon/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="amyliu.dev" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} · Amy Liu</title>
        <slot name="head" />
    </head>
    <ThemeClient />

    <body id="main-body" class="">
        <div class="bg-tertiary h-dvh [--header-height:calc(--spacing(14))]">
            <Page client:load>
                <div
                    id="app-header"
                    class="sticky top-0 z-100 **:w-full w-full bg-black h-(--header-height)! overflow-hidden"
                >
                    <Header />
            </div>
                <main id="app-main" class="page-animation bg-primary">
                    <slot />
                </main>
                <footer id="app-footer" class=""><Footer /></footer>
            </Page>
        </div>
    </body>


</html>
