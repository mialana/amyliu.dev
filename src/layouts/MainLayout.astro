---
import "@/styles/global.css";

import { Font } from "astro:assets";

import Header from "@/components/Header.astro";
import SideBar from "@/components/SideBar.astro";
import Footer from "@/components/Footer.astro";
import ToolBar from "@/components/ToolBar.astro";

type Layout = "BOTH" | "NO_NAV" | "NO_ASIDE" | "NONE";
interface Props {
    title: string;
    layout?: Layout;
    mainGridCellStyleOverrides?: string;
}

const { title, layout = "BOTH", mainGridCellStyleOverrides = "" } = Astro.props;

const isNavActive = layout === "BOTH" || layout === "NO_ASIDE";
const isAsideActive = layout === "BOTH" || layout === "NO_NAV";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-title" content="amyliu.dev" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        {/* placeholder that is updated in `handleTheme` script */}
        <meta name="theme-color" content="#000000" />
        <Font cssVariable="--fontvar-fredericka-the-great" />
        <Font cssVariable="--fontvar-atkinson-hyperlegible-next" />
        <Font cssVariable="--fontvar-jetbrains-mono" />
        <Font cssVariable="--fontvar-noto-sans-math" />
        <title>{title} · Amy Liu</title>
        <slot name="head" />
        {/* put in head to minimize latency */}
        <script is:inline src="/resources/js/handleTheme.js" defer></script>
    </head>
    <body>
        <div
            id="app"
            data-layout={layout}
            class=`group/app desktop:bg-tertiary-shade bg-primary-neutral h-svh overflow-hidden grid`>
            <header id="header-grid-cell" class="bg-secondary-shade col-span-full">
                <Header />
            </header>
            <div id="toolbar-grid-cell" class="bg-secondary-shade desktop:mb-4 col-span-full brightness-75">
                <ToolBar isNavActive={isNavActive} isAsideActive={isAsideActive} />
            </div>
            {
                isNavActive && (
                    <nav
                        id="nav-grid-cell"
                        class="bg-primary-neutral desktop:rounded-r-sm desktop:shadow-md overflow-hidden">
                        <SideBar sideBarType="nav">
                            <slot name="nav-sidebar" />
                        </SideBar>
                    </nav>
                )
            }
            <main
                id="main-grid-cell"
                class=`page-animation bg-primary-shade desktop:rounded-sm desktop:mx-4 desktop:shadow-md debug monitor:*:max-w-5xl flex overflow-x-clip overflow-y-scroll p-6 *:m-auto *:max-w-4xl *:grow ${mainGridCellStyleOverrides}`>
                <slot />
            </main>
            {
                isAsideActive && (
                    <aside
                        id="aside-grid-cell"
                        class="bg-primary-neutral desktop:rounded-l-sm desktop:shadow-md overflow-hidden">
                        <SideBar sideBarType="aside">
                            <slot name="aside-sidebar" />
                        </SideBar>
                    </aside>
                )
            }

            <footer id="footer-grid-cell" class="bg-secondary-shade desktop:mt-4 col-span-full"><Footer /></footer>
        </div>
        <script>
            import handleScrollBehavior from "../lib/projects/handleScrollBehavior.ts";
            handleScrollBehavior();
        </script>
    </body>
</html>
