---
import "@/styles/global.css";
import "@/styles/main.css";
import Header from "@/components/Header.astro";
import SideBar from "@/components/SideBar";
import Footer from "@/components/Footer.astro";

import parseLayout from "@/lib/parseLayout";

const LayoutMap = {
    DEFAULT: "grid-cols-[auto_minmax(0,1fr)_auto]",
    HIDE_NAV: "grid-cols-[0px_minmax(0,1fr)_auto]",
    HIDE_ASIDE: "grid-cols-[auto_minmax(0,1fr)_0px]",
    HIDE_BOTH: "grid-cols-[0px_minmax(0,1fr)_0px]",
};

interface Props {
    title: string;
    layout?: keyof typeof LayoutMap;
}

const { title, layout = "DEFAULT" } = Astro.props;

const grid_cols = LayoutMap[layout];

const { navActive, asideActive } = parseLayout(grid_cols);

import ThemeClient from "@/lib/ThemeClient.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            type="image/png"
            href="/favicon/favicon-96x96.png"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
        <link rel="shortcut icon" href="/favicon/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/favicon/apple-touch-icon.png"
        />
        <meta name="apple-mobile-web-app-title" content="amyliu.dev" />
        <link rel="manifest" href="/favicon/site.webmanifest" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} · Amy Liu</title>
        <slot name="head" />
        <ThemeClient />
    </head>

    <body
        id="main-body"
        class=`grid *:relative grid-rows-[auto_minmax(0,1fr)_auto] ${grid_cols}`
    >
        <header id="header-grid-cell" class="col-span-3">
            <Header />
        </header>
        <nav id="nav-grid-cell" class="transition-transform duration-1000">
            <SideBar category="NAV" active={navActive} client:load>
                <slot name="nav-sidebar" />
            </SideBar>
        </nav>
        <main id="main-grid-cell" class="page-animation">
            <slot />
        </main>
        <aside id="aside-grid-cell" class="transition-transform duration-1000">
            <SideBar category="ASIDE" active={asideActive} client:load>
                <slot name="aside-sidebar" />
            </SideBar>
        </aside>
        <footer id="footer-grid-cell" class="col-span-3"><Footer /></footer>
    </body>
</html>
