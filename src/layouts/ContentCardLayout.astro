---
// a variation for a card that has another collection it was sourced from (i.e. tags)
import { format as dateFormat } from "date-fns";
import { Image } from "astro:assets";

import { format } from "@/lib/utils";

import RightArrowIcon from "~icons/tabler/arrow-big-right-filled";

import DetailsSummary from "@/components/DetailsSummary.astro";

import { type ContentView } from "@/lib/query";

export interface CardSource {
    title: string;
    slug: string;
    kind: string;
}

interface Props {
    content: ContentView;
    source: CardSource;
}

const { content, source } = Astro.props as Props;
const { title: srcTitle, slug: srcSlug, kind: srcKind } = source;

const idPattern = `content-card__${content.id}__${srcKind}_${srcSlug}--{0}`;
---

{/* `tabindex=0` denotes focusable with auto-ordering */}
<li id={format(idPattern, "container")} class=`group/card relative m-auto max-w-xl` tabindex="0">
    {
        content.thumbnail.src.startsWith("https") ? (
            <img
                id={format(idPattern, "card-hero")}
                class="w-full"
                alt={`${content.title} Card Hero Image for '${srcTitle}' ${srcKind}`}
                src={content.thumbnail.src}
            />
        ) : (
            <Image
                id={format(idPattern, "card-hero")}
                class="w-full"
                alt={`${content.title} Card Hero Image for '${srcTitle}' ${srcKind}`}
                src={content.thumbnail}
            />
        )
    }
    <section
        id=`${idPattern}--card-overview`
        class=`prose-custom monitor:gap-sm gap-md bg-primary-shade/75 content-animation absolute top-0 flex size-full max-w-none flex-col overflow-y-scroll p-4 text-right invisible opacity-0 contrast-175 transition-opacity group-focus-within/card:visible group-focus-within/card:opacity-100 group-hover/card:visible group-hover/card:opacity-100 prose-custom-sm monitor:prose-custom-xs`>
        <h1 class="font-signature m-0">
            {content.title}
        </h1>
        <div>
            <code>
                {content.dateString}
            </code>
            <br />
            <code class="uppercase">
                {content.labelsString}
            </code>
        </div>
        <button
            aria-label=`${content.title} Card Hero Image for '${srcTitle}' ${srcKind}`
            class="bg-inverted-tertiary p-xdouble-y-4 relative w-fit place-self-end rounded-md border text-sm hover:brightness-150">
            <a href={content.href} class="text-inverted-important-text gap-sm size-full"
                >Take Me There<RightArrowIcon class="u-icon" />
            </a>
        </button>

        <details class="mt-auto cursor-default">
            <DetailsSummary>More tags for this tag!</DetailsSummary>
            <ul class="not-prose font-github-code gap-2xs flex flex-wrap py-2">
                {
                    content.tagsView.map((t) => (
                        <li id={`${idPattern}--link-to-${t.id}-${t.data.variant}`} class="inline rounded-xs">
                            <a
                                href={`/tags/${t.id}`}
                                title={`Go to ${t.data.variant} page for '${t.id}'`}
                                class={`${t.data.variant === "tag" ? "text-violet-accent" : "text-orange-accent"} relative px-2 hover:brightness-125`}>
                                #{t.id}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </details>
    </section>
</li>
