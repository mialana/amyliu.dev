---
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import TitleBodyLayout from "@/layouts/TitleBodyLayout.astro";
import TagsIndex from "@/components/TagsIndex.tsx";

const projects = await getCollection("projects");

const allTags = projects.flatMap((project: any) => [
    ...project.data.tags,
    ...project.data.techStack,
]);

const tagCounts = allTags.reduce((acc: Record<string, number>, tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
    return acc;
}, {});

const uniqueTags = Object.keys(tagCounts).sort();

const tagCloudData = uniqueTags.map((tag) => ({
    value: tag,
    count: tagCounts[tag],
}));

const title = "Tags Index";
---

<MainLayout title={title}>
    <TitleBodyLayout title={title}>
        <TagsIndex tagCloudData={tagCloudData} client:load /></TitleBodyLayout
    >
</MainLayout>
