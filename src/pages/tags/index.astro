---
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/MainLayout.astro";
import TagsIndex from "@/components/TagsIndex.tsx";

const projects = await getCollection("projects");

const allTags = projects.flatMap((project: any) => [
    ...project.data.tags,
    ...project.data.techStack,
]);

const tagCounts = allTags.reduce((acc: Record<string, number>, tag) => {
    acc[tag] = (acc[tag] ?? 0) + 1;
    return acc;
}, {});

const uniqueTags = Object.keys(tagCounts).sort();

const tagCloudData = uniqueTags.map((tag) => ({
    value: tag,
    count: tagCounts[tag],
}));
---

<MainLayout title="Tags Index">
    <div class="prose m-auto max-w-none p-8 text-center md:max-w-3/4">
        <h1>Tags Index</h1>

        <TagsIndex
            uniqueTags={uniqueTags}
            tagCloudData={tagCloudData}
            client:load
        />
    </div>
</MainLayout>
