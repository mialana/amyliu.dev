---
import { getCollection } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

import createSlug from "@/lib/createSlug";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    // Include tech stack as honorary tags
    const uniqueRawTags = [
        ...new Set(
            projects
                .map((project: any) => [
                    ...project.data.tags,
                    ...project.data.techStack,
                ])
                .flat(),
        ),
    ];

    return uniqueRawTags.map((tag) => {
        const filteredProjects = projects
            .filter(
                (project: any) =>
                    project.data.tags.includes(tag) ||
                    project.data.techStack.includes(tag),
            )
            .sort(
                (a, b) =>
                    b.data.startDate.valueOf() - a.data.startDate.valueOf(),
            );
        return { params: { tag: tag }, props: { projects: filteredProjects } };
    });
}

const { tag: tag } = Astro.params;
const { projects } = Astro.props;

const tagTitle = tag.replaceAll("_", " ");
---

<MainLayout title={tagTitle} layout="HIDE_BOTH">
    <div class="w-full text-center">
        <div class="absolute top-0 z-20 h-4 w-full bg-white"></div>
        <div
            class="prose prose-sm lg:prose-base bg-wanderer-100/90 sticky top-2 z-20 mx-auto my-8 w-fit rounded-md px-2"
        >
            <h3 class="font-extralight">
                PROJECTS UNDER <a
                    href=""
                    class="text-wanderer-300 mx-1 rounded-sm py-1 font-normal tracking-widest"
                    >{tagTitle}</a
                > TAG
            </h3>
        </div>

        <ul>
            {
                projects.map((project: any) => (
                    <li>
                        <div class="**:prose-h1:hover:text-red-accent **:prose-h1:hover:scale-105 **:prose-h1:pt-8 **:prose-h1:animate-bounce **:prose-h1:after:cursor-pointer **:prose-h1:after:content-['→'] size-full">
                            <ProjectLayout
                                project={project}
                                showBreakdown={false}
                            />
                        </div>
                        <hr class="mx-auto mt-4 mb-10 w-1/2 border-1 border-neutral-300 xl:mt-8 xl:mb-16" />
                    </li>
                ))
            }
        </ul>
    </div>
</MainLayout>
