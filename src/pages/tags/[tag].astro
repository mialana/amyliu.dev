---
import { getCollection } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import HorizontalProjectCardLayout from "@/layouts/HorizontalProjectCardLayout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    // Getall tags in database and map to a set. Include tech stack as honorary tags
    const uniqueRawTags = [
        ...new Set(projects.map((project: any) => [...project.data.tags, ...project.data.techStack]).flat()),
    ];

    return uniqueRawTags.map((tag) => {
        const filteredProjects = projects
            .filter((project: any) => project.data.tags.includes(tag) || project.data.techStack.includes(tag))
            .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
        return { params: { tag: tag }, props: { projects: filteredProjects } };
    });
}

const { tag: tag } = Astro.params;
const { projects } = Astro.props;

const tagTitle = tag.replaceAll("_", " ");
const prefix = `${tag}-tag-`;
---

<MainLayout title={tagTitle} layout="NONE">
    <div id=`${prefix}container`>
        <div class="prose bg-inverted-neutral/25 sticky top-0 z-30 mb-4 w-fit rounded-sm px-2">
            <h1>{tagTitle}</h1>
        </div>
        <ul id=`${prefix}project-list` class="gap-lg flex flex-col">
            {projects.map((project: any) => <HorizontalProjectCardLayout project={project} idPrefix={prefix} />)}
        </ul>
    </div>
</MainLayout>
