---
import { getCollection } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

import createSlug from "@/lib/createSlug";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    // Include tech stack as honorary tags
    const uniqueRawTags = [
        ...new Set(
            projects
                .map((project: any) => [
                    ...project.data.tags,
                    ...project.data.techStack,
                ])
                .flat(),
        ),
    ];

    return uniqueRawTags.map((tag) => {
        const filteredProjects = projects
            .filter(
                (project: any) =>
                    project.data.tags.includes(tag) ||
                    project.data.techStack.includes(tag),
            )
            .sort(
                (a, b) =>
                    b.data.startDate.valueOf() - a.data.startDate.valueOf(),
            );
        return { params: { tag: tag }, props: { projects: filteredProjects } };
    });
}

const { tag: tag } = Astro.params;
const { projects } = Astro.props;

const tagTitle = tag.replaceAll("_", " ");
---

<MainLayout title={tagTitle} layout="HIDE_BOTH">
    <div
        class="flex size-full flex-col overflow-y-visible px-2 pb-4 md:px-8 md:pb-8"
    >
        <div class="absolute top-0 z-20 h-4 w-full bg-white md:h-8"></div>
        <div
            class="prose prose-base lg:prose-lg border-wanderer-300/25 shadow-wanderer-300/50 to-wanderer-200/90 from-green-accent/80 sticky top-2 z-20 my-0 ml-2 w-fit scale-y-90 rounded-br-lg border-t-3 border-l-4 bg-linear-to-br shadow-lg md:top-4 md:my-4 md:ml-4"
        >
            <h3 class="px-2 py-1 font-extralight uppercase">
                <a
                    href=`#${tagTitle}-top`
                    class="text-wanderer-300 font-signature hover:text-wanderer-100 mx-1 !min-h-full font-normal tracking-widest normal-case underline-offset-2"
                    >{tagTitle}</a
                >
            </h3>
        </div>

        <div class="flex grow flex-col justify-center-safe overflow-y-hidden">
            <ul
                class="md:items-start-safe relative flex snap-y flex-col justify-center-safe gap-4 overflow-x-visible overflow-y-scroll py-4 md:snap-x md:flex-row md:gap-12 md:overflow-x-scroll md:overflow-y-hidden"
            >
                <div
                    id=`${tagTitle}-top`
                    class="absolute top-0 left-0 !m-0 size-0 shrink"
                >
                </div>
                {
                    projects.map((project: any) => (
                        <li class="content-animation **:prose-h1:text-2xl **:prose-h1:hover:scale-103 **:prose-h1:underline **:prose-h1:underline-offset-2 **:prose-h1:hover:underline **:prose-h1:pt-2 **:prose-h1:after:cursor-pointer **:prose-h1:after:content-['→'] h-fit min-h-fit w-full flex-1 snap-start overflow-y-visible rounded-xl bg-[#f9f9f9] px-1 shadow-md *:items-baseline md:max-h-full md:min-h-fit md:min-w-3/5 md:overflow-y-scroll md:*:!m-4 md:*:!p-4 xl:max-w-[1024px] xl:min-w-1/2">
                            <ProjectLayout
                                project={project}
                                showBreakdown={false}
                            />
                            {/* <hr class="border-0.5 mx-auto mt-4 mb-10 w-2/3 border-dashed border-neutral-300 xl:mt-8 xl:mb-16" /> */}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</MainLayout>
