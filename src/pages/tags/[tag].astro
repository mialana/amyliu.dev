---
import { getCollection } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

import createSlug from "@/lib/projects/createSlug";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    // Include tech stack as honorary tags
    const uniqueRawTags = [
        ...new Set(projects.map((project: any) => [...project.data.tags, ...project.data.techStack]).flat()),
    ];

    return uniqueRawTags.map((tag) => {
        const filteredProjects = projects
            .filter((project: any) => project.data.tags.includes(tag) || project.data.techStack.includes(tag))
            .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
        return { params: { tag: tag }, props: { projects: filteredProjects } };
    });
}

const { tag: tag } = Astro.params;
const { projects } = Astro.props;

const tagTitle = tag.replaceAll("_", " ");
---

<MainLayout title={tagTitle} layout="HIDE_BOTH">
    <div id="per-tag-container">
        <!-- tag banner -->
        <a id="per-tag-banner" href=`#${tagTitle}-top`>{tagTitle}</a>

        <ul id="per-tag-project-list" class="gap-lg desktop:flex-row desktop:overflow-x-scroll flex">
            {
                projects.map((project: any) => (
                    <li class="content-animation per-tag-project-card bg-primary-neutral w-2xl flex-1 shrink rounded-md p-4">
                        <ProjectLayout
                            project={project}
                            showBreakdown={false}
                            replaceImagePlaceholder={true}
                            showTags={false}
                        />
                    </li>
                ))
            }
        </ul>
    </div>
</MainLayout>
