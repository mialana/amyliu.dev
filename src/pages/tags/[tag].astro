---
import { getCollection } from "astro:content";

import "@/styles/tags.css";

import MainLayout from "@/layouts/MainLayout.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    // Include tech stack as honorary tags
    const uniqueRawTags = [
        ...new Set(
            projects
                .map((project: any) => [
                    ...project.data.tags,
                    ...project.data.techStack,
                ])
                .flat(),
        ),
    ];

    return uniqueRawTags.map((tag) => {
        const filteredProjects = projects
            .filter(
                (project: any) =>
                    project.data.tags.includes(tag) ||
                    project.data.techStack.includes(tag),
            )
            .sort(
                (a, b) =>
                    b.data.startDate.valueOf() - a.data.startDate.valueOf(),
            );
        return { params: { tag: tag }, props: { projects: filteredProjects } };
    });
}

const { tag: tag } = Astro.params;
const { projects } = Astro.props;

const tagTitle = tag.replaceAll("_", " ");
---

<MainLayout title={tagTitle} layout="HIDE_BOTH">
    <div
        class="flex size-full flex-col overflow-y-visible px-2 pb-4 md:px-8 md:pb-8"
    >
        <!-- background for sticky positioning -->
        <div class="bg-primary absolute top-0 z-20 h-2 w-full md:h-8"></div>
        <!-- tag banner -->
        <div
            class="prose prose-base lg:prose-lg bg-neutral-primary sticky top-4 z-20 my-0 ml-2 w-fit scale-y-90 rounded-md shadow-lg contrast-125 md:top-6 md:my-6 md:ml-0"
        >
            <h3 class="p-2">
                <a
                    href=`#${tagTitle}-top`
                    class="font-signature mx-1 min-h-full! font-semibold tracking-wide normal-case underline-offset-2"
                    >{tagTitle}</a
                >
            </h3>
        </div>

        <div class="flex grow flex-col justify-center-safe overflow-y-hidden">
            <ul
                class="md:items-start-safe relative flex flex-col justify-center-safe gap-4 overflow-x-visible overflow-y-scroll pb-4 md:snap-x md:flex-row md:gap-12 md:overflow-x-scroll md:overflow-y-hidden"
            >
                <div
                    id=`${tagTitle}-top`
                    class="absolute top-0 left-0 m-0! size-0 shrink"
                >
                </div>
                {
                    projects.map((project: any) => (
                        <li class="content-animation tag-project-card bg-inverted-secondary/50 border-inverted-neutral/75 flex-1 overflow-y-visible rounded-md border-4 border-double px-1 shadow-md md:snap-start md:overflow-y-scroll md:*:m-4! md:*:p-4!">
                            <ProjectLayout
                                project={project}
                                showBreakdown={false}
                                replaceImagePlaceholder={true}
                            />
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</MainLayout>
