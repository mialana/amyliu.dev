---
import { getCollection } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import TagProjectCardLayout, { type CardSource } from "@/layouts/TagProjectCardLayout.astro";
import TagHead from "@/components/TagHead.astro";

import type { InferGetStaticParamsType, InferGetStaticPropsType, GetStaticPaths } from "astro";

import { type ProjectEntryStructured, structureProject } from "@/lib/projects/query";

export const getStaticPaths = (async () => {
    const projects = await getCollection("projects");

    // Get all tags in database and map to a set. Include tech stack as honorary tags
    const uniqueRawTags = [
        ...new Set(projects.map((project: any) => [...project.data.tags, ...project.data.techStack]).flat()),
    ];

    return uniqueRawTags.map((tag: string) => {
        const filteredProjects: ProjectEntryStructured[] = projects
            .filter((project: any) => project.data.tags.includes(tag) || project.data.techStack.includes(tag))
            .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
            .map((p) => structureProject(p));
        return { params: { tag: tag }, props: { projects: filteredProjects } };
    });
}) satisfies GetStaticPaths;

type Params = InferGetStaticParamsType<typeof getStaticPaths>;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.params as Params;

const { projects } = Astro.props as Props;

const tagTitle = tag.replaceAll("_", " ");
const prefix = `${tag}-tag`;

const tagAsSource: CardSource = { title: tagTitle, slug: tag, kind: "tag" };
---

<MainLayout title={tagTitle} layout="NONE" mainGridCellStyleOverrides="u-grid-background">
    <TagHead slot="head" tag={tag} projects={projects} />
    <div id=`${prefix}--container` class="min-h-full">
        <div class="prose-custom bg-inverted-neutral/50 sticky top-0 z-30 mb-4 w-fit rounded-md px-2">
            <h1 class="text-inverted-important-text text-wrap">{tagTitle}</h1>
        </div>
        <ul
            id=`${prefix}--project-list`
            class="gap-lg desktop:grid monitor:[--card-grid-size:var(--container-xs)] flex grid-cols-[repeat(auto-fit,minmax(var(--card-grid-size),1fr))] flex-col items-center-safe [--card-grid-size:var(--container-sm)]">
            {
                projects.map((project) => (
                    <li class="contents">
                        <TagProjectCardLayout project={project} source={tagAsSource} />
                    </li>
                ))
            }
        </ul>
    </div>
</MainLayout>
