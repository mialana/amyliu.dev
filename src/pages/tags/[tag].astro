---
import { getCollection } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";

import createSlug from "@/lib/createSlug";

export async function getStaticPaths() {
    const projects = await getCollection("projects");

    // Include tech stack as honorary tags
    const uniqueRawTags = [
        ...new Set(
            projects
                .map((project: any) => [
                    ...project.data.tags,
                    ...project.data.techStack,
                ])
                .flat(),
        ),
    ];

    return uniqueRawTags.map((tag) => {
        const filteredProjects = projects
            .filter(
                (project: any) =>
                    project.data.tags.includes(tag) ||
                    project.data.techStack.includes(tag),
            )
            .sort(
                (a, b) =>
                    b.data.startDate.valueOf() - a.data.startDate.valueOf(),
            );
        return { params: { tag: tag }, props: { projects: filteredProjects } };
    });
}

const { tag: tag } = Astro.params;
const { projects } = Astro.props;

const tagTitle = tag.replaceAll("_", " ");
---

<MainLayout title={tagTitle} layout="HIDE_BOTH">
    <!-- <a
        href="/tags/"
        class="sticky top-0 z-1000 m-2 bg-neutral-900 py-3 pr-3 pl-6 text-xs text-white [clip-path:polygon(0%_50%,10%_0,100%_0,100%_100%,10%_100%)] hover:bg-neutral-700 md:m-4 md:text-base md:font-medium"
    >
        Back to <span class="underline underline-offset-4">Tags Index</span>
    </a> -->
    <div class="w-full p-2 pt-8 text-center">
        <div
            class="prose prose-sm lg:prose-base sticky top-2 z-20 m-auto rounded-md bg-white px-2"
        >
            <h3 class="mb-8">
                PROJECTS UNDER <span
                    class="text-wanderer-300 mx-1 rounded-sm bg-neutral-100 px-2 py-1 tracking-widest"
                    >{tagTitle}</span
                > TAG
            </h3>
        </div>

        <ul>
            {
                projects.map((project: any) => (
                    <li>
                        <a
                            href={`/projects/${createSlug(
                                project.data.title,
                                project.data.slug,
                            )}/`}
                            class="text-red-accent text-xl font-bold underline hover:text-2xl"
                            title="View on page"
                        >
                            {project.data.title}
                        </a>

                        <ProjectLayout
                            project={project}
                            showBreakdown={false}
                        />
                        <hr class="mx-auto mt-4 mb-10 w-1/2 border-1 border-neutral-300 xl:mt-8 xl:mb-16" />
                    </li>
                ))
            }
        </ul>
    </div>
</MainLayout>
