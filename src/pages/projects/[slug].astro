---
import { getCollection, render, type CollectionEntry } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import ProjectExternalLinks from "@/components/ProjectExternalLinks";
import ProjectHead from "@/components/ProjectHead.astro";

// Generate a new path for every collection entry
export async function getStaticPaths() {
    const projects = await getCollection("projects");

    return projects.map((project) => {
        return { params: { slug: project.data.slug }, props: { project } };
    });
}

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { Content, headings } = await render(project);

const fallbackHeading = {
    depth: 1,
    slug: `updated-${new Date().toISOString().split("T")[0]}`,
    text: `Updated: ${new Date().toISOString().split("T")[0]}`,
};

if (!headings.length) {
    headings.push(fallbackHeading);
}
---

<MainLayout title={project.data.title} layout="HIDE_ASIDE">
    <ProjectHead slot="head" project={project} />
    <script is:inline slot="head" src="/vendor/temml/temml.min.js"></script>

    <TableOfContents headings={headings} slot="nav-sidebar" />

    <ProjectLayout project={project}>
        <Content />
    </ProjectLayout>

    {
        (project.data.code || project.data.externalLinks) && (
            <section slot="aside-sidebar">
                <ProjectExternalLinks code={project.data.code} externalLinks={project.data.externalLinks} client:load />
            </section>
        )
    }

    <script is:inline slot="body" src="/resources/js/copyHeadingLinkToClipboard.js"></script>
</MainLayout>
