---
export const prerender = false;

import { getCollection } from "astro:content";

import MainLayout from "@/layouts/MainLayout.astro";
import ProjectCardLayout from "@/layouts/ProjectCardLayout.astro";
import ProjectSelect from "@/components/ProjectsSelect.astro";
import TableOfContents from "@/components/TableOfContents.astro";

import {
    getProjectIndexData,
    projectSortOrderArray,
    augmentProjectEntry,
    type ProjectEntryAugmented,
    type ProjectSortOrder,
} from "@/lib/projects/query";

const projects: ProjectEntryAugmented[] = (await getCollection("projects")).map((p) => augmentProjectEntry(p));

// use URL to set `sortOrder`
const maybeSortOrder: any | null = Astro.url.searchParams.get("sortOrder");
let sortOrder: ProjectSortOrder =
    maybeSortOrder && projectSortOrderArray.includes(maybeSortOrder) ? maybeSortOrder : projectSortOrderArray[0];

/* separate out data parsing into separate module in lib */
const { sections, tocHeadings } = getProjectIndexData(projects, sortOrder);
---

<MainLayout title="Projects" layout="NO_ASIDE">
    <meta slot="head" name="description" content="This is the projects index page of the site." />

    <div slot="nav-sidebar">
        <ProjectSelect scrollableAncestor="#nav-sidebar" />
        <TableOfContents tocRootNode={tocHeadings} />
    </div>

    <ul class="gap-xl flex flex-col">
        {
            sections.map((section) => (
                <l1>
                    <div class="prose-custom prose-sm mx-auto mb-(--gap-lg) text-center">
                        {/* basis-full ensures the header takes up the full flex row */}
                        <h1 id={section.key} class="">
                            {section.title}
                        </h1>
                    </div>
                    <ul class={`gap-xl flex flex-wrap items-start justify-center`}>
                        {section.projectIndices.map((idx) => (
                            <ProjectCardLayout project={projects[idx]} />
                        ))}
                    </ul>
                </l1>
            ))
        }
    </ul>
</MainLayout>
