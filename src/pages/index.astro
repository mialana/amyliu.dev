---
import "@/styles/global.css";

import { Image } from "astro:assets";

import MainLayout from "@/layouts/MainLayout.astro";

import Headshot2025_2 from "@/assets/png/headshot-2025-2.png";
---

<MainLayout title="Home" layout="DEFAULT">
    <div
        class="mx-auto flex flex-col items-center-safe justify-start gap-8 px-4 py-8 HORIZONTAL:flex-row HORIZONTAL:justify-center-safe"
    >
        <div
            class="min-h-3xs flex aspect-square max-w-md flex-col items-center justify-center overflow-visible"
        >
            <Image
                src={Headshot2025_2}
                alt="Amy Liu Headshot 2 from Barcelona, Spain"
                width={800}
                class="grow rounded-full"
            />
        </div>

        <div class="prose prose-sm lg:prose-base max-w-3xl px-4">
            <h4
                class="font-code **:text-important-text text-center leading-tight font-semibold HORIZONTAL:text-left"
            >
                <div id="typed-strings">
                    <p>
                        › Computer Graphics Engineer ^1000
                        <br />› Game Developer ^1000
                        <br />› Technical Artist ^1000
                        <br />› Code Junkie
                    </p>
                </div>
                <span id="typed"></span>
            </h4>
            <div>
                <!-- <hr class="mx-auto w-1/3 border-dashed border-neutral-300" /> -->
                <p>
                    Hi, I'm <b class="text-green-accent">Amy</b>. Welcome to my
                    website -- a one-stop shop for my CG personal portfolio.
                </p>
                <p>
                    I'm currently an undergrad at the University of Pennsylvania
                    pursuing a <b class="text-blue-accent"
                        >BSE in Digital Media Design</b
                    > (Computer Graphics) and an <b class="text-red-accent"
                        >Accelerated Master's in Computer Graphics and Game
                        Technology</b
                    >. I will be graduating in <b>May 2026</b>.
                </p>
                <p>
                    Here, you can easily scroll and filter through my past
                    <b>projects</b>, watch their corresponding <b>demo videos</b
                    >, and read through each <b>project breakdown</b> for more information.
                    I am also gradually expanding on the content, such as including
                    my work in 3D-modeling and 2D art.
                </p>

                <!-- <hr class="mx-auto w-1/3 border-dashed border-neutral-300" /> -->
                <p class="font-light">
                    <em>
                        "The student keeps her eyes on the sky but her feet
                        steady on the ground. She builds a staircase of books,
                        all the way to the stars."
                    </em>
                </p>
            </div>
        </div>
    </div>
</MainLayout>

<script>
    import Typed from "typed.js";

    var typed = new Typed("#typed", {
        stringsElement: "#typed-strings",
        typeSpeed: 30,
        showCursor: false,
    });
</script>
