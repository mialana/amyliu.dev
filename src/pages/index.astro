---
import "@/styles/global.css";

import { Image } from "astro:assets";

import MainLayout from "@/layouts/MainLayout.astro";

import Headshot2025_2 from "@/assets/png/headshot-2025-2.png";
---

<MainLayout title="Home" layout="NONE">
    <meta slot="head" name="description" content="Welcome to the homepage of my site!" />

    <div class="desktop:flex-row desktop:gap-16 bg-primary-shade flex flex-col items-center-safe justify-start gap-8">
        <div class="aspect-square max-w-lg">
            <Image
                src={Headshot2025_2}
                alt="Amy Liu Headshot 2 from Barcelona, Spain"
                width={800}
                class="rounded-full"
            />
        </div>

        <div class="prose desktop:text-left prose-sm desktop:prose-base desktop:max-w-3/5 text-center">
            <div id="typed-strings">
                <p>
                    › Computer Graphics Engineer ^1000
                    <br />› Game Developer ^1000
                    <br />› Technical Artist ^1000
                    <br />› Code Junkie
                </p>
            </div>
            <samp id="typed"></samp>
            <p>
                Hi, I'm <b class="text-green-accent">Amy</b>. Welcome to my website -- a one-stop shop for my CG
                personal portfolio.
            </p>
            <p>
                I'm currently an undergrad at the University of Pennsylvania pursuing a <b class="text-blue-accent"
                    >BSE in Digital Media Design</b
                > (Computer Graphics) and an <b class="text-red-accent"
                    >Accelerated Master's in Computer Graphics and Game Technology</b
                >. I will be graduating in <b>May 2026</b>.
            </p>
            <p>
                Here, you can easily scroll and filter through my past
                <b>projects</b>, watch their corresponding <b>demo videos</b>, and read through each <b
                    >project breakdown</b
                > for more information. I am also gradually expanding on the content, such as including my work in 3D-modeling
                and 2D art.
            </p>

            <q>
                The student keeps her eyes on the sky but her feet steady on the ground. She builds a staircase of
                books, all the way to the stars.
            </q>
        </div>
    </div>
</MainLayout>

<script>
    import Typed from "typed.js";

    var typed = new Typed("#typed", { stringsElement: "#typed-strings", typeSpeed: 30, showCursor: false });
</script>
