{
    "extends": "astro/tsconfigs/strict",
    "include": [
        ".astro/types.d.ts",
        ".prettierrc.mjs",
        "astro.config.ts",
        "src/types/*",
        "./worker-configuration.d.ts",
        "**/*"
    ],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "baseUrl": ".",
        "paths": { "@/*": ["./src/*"] },
        "types": ["./worker-configuration.d.ts", "node"]
    }
}
