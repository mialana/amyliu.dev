{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", ".prettierrc.ts", "astro.config.ts", "src/types/*", "src/**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "paths": { "@/*": ["./src/*"] },
        "types": ["node"]
    }
}
